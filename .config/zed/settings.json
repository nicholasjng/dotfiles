{
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },
  "inlay_hints": {
    "show_type_hints": false,
    "enabled": true,
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "base_keymap": "VSCode",
  "hard_tabs": false,
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "Tokyo Night Storm",
  },
  "languages": {
    "C++": {
      "language_servers": ["clangd"],
      "format_on_save": "on",
      "tab_size": 4,
    },
    "YAML": {
      "format_on_save": "off",
    },
    "Python": {
      "code_actions_on_format": {
        "source.fixAll.ruff": true,
        "source.organizeImports.ruff": true,
      },
      "preferred_line_length": 100,
      "inlay_hints": {
        "enabled": true,
      },
      "language_servers": ["ruff", "ty"],
      "format_on_save": "on",
      "formatter": [{ "language_server": { "name": "ruff" } }],
    },
  },
  "lsp": {
    "ty": {
      "settings": {
        "inlayHints": {
          "variableTypes": false,
        },
      },
    },
  },
}
